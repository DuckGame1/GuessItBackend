  "components": {
    "schemas": {
      "AuthModel": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Card": {
        "type": "object",
        "properties": {
          "cardId": {
            "type": "integer",
            "format": "int32"
          },
          "cardCategoryId": {
            "type": "integer",
            "format": "int32"
          },
          "cardName": {
            "type": "string",
            "nullable": true
          },
          "cardImage": {
            "type": "string",
            "format": "byte",
            "nullable": true
          },
          "cardCategory": {
            "$ref": "#/components/schemas/CardsCategory"
          }
        },
        "additionalProperties": false
      },
      "CardsCategory": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "integer",
            "format": "int32"
          },
          "categoryName": {
            "type": "string",
            "nullable": true
          },
          "categoryDescription": {
            "type": "string",
            "nullable": true
          },
          "categoryImage": {
            "type": "string",
            "format": "byte",
            "nullable": true
          },
          "categoryOwnerId": {
            "type": "integer",
            "format": "int32"
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            },
            "nullable": true
          },
          "categoryOwner": {
            "$ref": "#/components/schemas/User"
          },
          "userSubscribes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserSubscribe"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "GameStatus": {
        "enum": [
          0,
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "Teams": {
        "enum": [
          0,
          1
        ],
        "type": "integer",
        "format": "int32"
      },
      "User": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "username": {
            "type": "string",
            "nullable": true
          },
          "passwordHash": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "nullable": true
          },
          "cardsCategories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CardsCategory"
            },
            "nullable": true
          },
          "userData": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserDatum"
            },
            "nullable": true
          },
          "userSubscribes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserSubscribe"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UserDatum": {
        "type": "object",
        "properties": {
          "avatarId": {
            "type": "integer",
            "format": "int32"
          },
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "avatar": {
            "type": "string",
            "format": "byte",
            "nullable": true
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "additionalProperties": false
      },
      "UserSubscribe": {
        "type": "object",
        "properties": {
          "subscribeId": {
            "type": "integer",

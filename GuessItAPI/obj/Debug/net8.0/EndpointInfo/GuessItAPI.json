    "/giapi/category/searchcategories": {
      "get": {
        "tags": [
          "Category"
        ],
        "summary": "Ищет все категории, удовлетворяющие условиям поиска",
        "parameters": [
          {
            "name": "categoryId",
            "in": "query",
            "description": "ID категории",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "categoryName",
            "in": "query",
            "description": "Имя категории",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ownerId",
            "in": "query",
            "description": "ID владельца категории",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "ownerName",
            "in": "query",
            "description": "Имя владельца категории",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includeCards",
            "in": "query",
            "description": "Включить связанные карточки",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "showSubscribed",
            "in": "query",
            "description": "true — только подписанные, false — только неподписанные, null — все",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "description": "ID пользователя (взаимоисключимо с username)",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "username",
            "in": "query",
            "description": "Имя пользователя (взаимоисключимо с userId)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "showOwnerInfo",
            "in": "query",
            "description": "Показывать владельца категории",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Json с категориями",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CardsCategory"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CardsCategory"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CardsCategory"
                  }
                }
              }
            }
